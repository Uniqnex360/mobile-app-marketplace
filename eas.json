{
  "cli": {
    "version": ">= 16.26.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "image": "latest"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "image": "latest"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "image": "latest"
      },
      "env": {
        "EAS_BUILD_POST_INSTALL_COMMAND": "./scripts/eas-build-post-install.sh"
      }
    }
  },
  "submit": {
    "production": {}
  }
}